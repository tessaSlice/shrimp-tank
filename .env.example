# Set GROK_API_KEY in the project-root .env to enable live dialogue.
# The key is read only by FastAPI and is never exposed to the browser.
GROK_API_KEY=
GROK_MODEL=grok-4.3
GROK_REASONING_EFFORT=none
GROK_BASE_URL=https://api.x.ai/v1
GROK_TIMEOUT_SECONDS=3600

# Persistent session storage. SPACETIMEDB_TOKEN is the database-owner token
# from `spacetime login show --token`; never commit it.
SESSION_STORE=spacetime
SPACETIMEDB_URI=https://maincloud.spacetimedb.com
SPACETIMEDB_DATABASE=credit-tank-state
SPACETIMEDB_TOKEN=

# Comma-separated browser origins allowed to call the API (and connect by WebSocket).
# LAN example: FRONTEND_ORIGINS=http://192.168.1.42:5173
# Example: FRONTEND_ORIGINS=https://shrimp-tank.onrender.com
FRONTEND_ORIGINS=
